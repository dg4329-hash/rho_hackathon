{
  "name": "daemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "mesh": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
