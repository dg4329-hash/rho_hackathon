    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "express": "^4.21.0",
    "minimatch": "^10.0.1",
    "shell-quote": "^1.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2"
  }
