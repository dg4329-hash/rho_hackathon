{
  "user": "dev",
  "room": "rho",
  "relay": "ws://localhost:8080",
  "cwd": ".",
  "timeoutSeconds": 120,
  "allowArbitrary": "ask",
  "gitOffers": true,
  "codexWake": false,
  "import": { "fromClaudeCode": true, "fromCursor": true, "servers": ["*"], "defaultPermission": "ask" },
  "permissions": { "*.list_*": "always", "*.get_*": "always", "*.delete_*": "never" },
  "notes": { "supabase.*": "Prod project ref abcd1234. Users are in public.profiles. Read-only unless the user says otherwise." },
  "offers": [
    { "name": "echo", "command": "echo", "description": "Echo text back. Usage: echo <text>", "permission": "always" },
    { "name": "gh", "command": "gh", "description": "GitHub CLI. Prefer read-only subcommands.", "permission": "ask" }
  ]
}
